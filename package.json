{
  "name": "claude-storehouse",
  "version": "1.1.0",
  "description": "A local web dashboard for your Claude Code setup. See, edit, switch on or off, and favorite every skill, agent, plugin, hook, MCP server, setting, and CLAUDE.md, global and per project.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "dashboard",
    "skills",
    "agents",
    "plugins",
    "mcp",
    "hooks",
    "cli",
    "developer-tools",
    "ai"
  ],
  "author": "Sumonta Saha Mridul",
  "license": "MIT",
  "type": "module",
  "bin": {
    "claude-storehouse": "bin/storehouse.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js test/*/*.test.js",
    "start": "node bin/storehouse.js",
    "site": "node site/build.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "open": "^11.0.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumonta056/claude-storehouse.git"
  },
  "homepage": "https://github.com/Sumonta056/claude-storehouse#readme",
  "bugs": {
    "url": "https://github.com/Sumonta056/claude-storehouse/issues"
  }
}
