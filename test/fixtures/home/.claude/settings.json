{
  "model": "fable",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ecc@ecc": false
  },
  "skillOverrides": {
    "old": "off",
    "java-clean-code": "off"
  },
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "~/.claude/hooks/stop.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "~/.claude/hooks/pre-bash.sh", "timeout": 60 } ] }
    ]
  }
}
